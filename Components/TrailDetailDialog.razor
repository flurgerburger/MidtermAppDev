@inject NavigationManager Navigation

<MudDialog Class="backdrop-blur-md max-w-2xl w-full bg-slate-900 border border-slate-800 text-slate-100 rounded-3xl overflow-hidden">
    <TitleContent>
        <div class="flex items-start justify-between gap-4 pt-2 px-2">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @GetDifficultyBadgeClass(Trail.Difficulty)">
                        @Trail.Difficulty
                    </span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @GetStatusBadgeClass(Trail.Status)">
                        <span class="w-1.5 h-1.5 rounded-full mr-1.5 @GetStatusDot(Trail.Status)"></span>
                        @Trail.Status
                    </span>
                </div>

                <h2 class="text-2xl font-black text-white tracking-tight">
                    @Trail.TrailName
                </h2>

                <div class="flex items-center gap-1.5 text-xs text-emerald-400 font-medium mt-1">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="!w-4 !h-4" />
                    <span>@Trail.LocalMunicipality, Cebu Island</span>
                </div>
            </div>

            <div class="flex items-center gap-1 px-3 py-1.5 rounded-xl bg-slate-950/80 border border-slate-800 text-amber-400 font-bold text-sm">
                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="!w-4 !h-4" />
                <span>@Trail.Rating.ToString("F1")</span>
            </div>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="space-y-6 py-4 px-2">
            <!-- Key Telemetry Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 text-center">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Elevation</span>
                    <span class="font-mono font-extrabold text-base text-white mt-1 block">@Trail.ElevationMeters m</span>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 text-center">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Distance</span>
                    <span class="font-mono font-extrabold text-base text-white mt-1 block">@Trail.DistanceKm.ToString("F1") km</span>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 text-center">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Est. Time</span>
                    <span class="font-mono font-extrabold text-base text-white mt-1 block">~@Trail.EstimatedMinutes mins</span>
                </div>

                <div class="p-3.5 rounded-2xl bg-slate-950/70 border border-slate-800 text-center">
                    <span class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">Access Fee</span>
                    <span class="font-mono font-extrabold text-base text-emerald-400 mt-1 block">
                        @(Trail.PermitFee == 0 ? "Free" : $"₱{Trail.PermitFee:N0}")
                    </span>
                </div>
            </div>

            <!-- Full Trail Description -->
            <div class="p-4 sm:p-5 rounded-2xl bg-slate-950/50 border border-slate-800/80">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2 flex items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="text-emerald-400 !w-4 !h-4" />
                    <span>Trail Overview</span>
                </h4>
                <p class="text-sm text-slate-200 leading-relaxed">
                    @Trail.Description
                </p>
            </div>

            <!-- Safety Guidelines & Trail Notes -->
            <div class="p-4 sm:p-5 rounded-2xl bg-emerald-950/20 border border-emerald-900/40">
                <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-300 mb-2 flex items-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="text-emerald-400 !w-4 !h-4" />
                    <span>Safety Guidelines & Advisory</span>
                </h4>
                <p class="text-xs sm:text-sm text-emerald-100/90 leading-relaxed">
                    @Trail.SafetyNotes
                </p>
                <div class="mt-3 text-[11px] text-emerald-300/80 font-medium">
                    * Always practice "Leave No Trace" principles. Never leave litter or disturb local wildlife along Cebu's mountain ridges.
                </div>
            </div>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="flex items-center justify-between gap-3 px-4 py-3 w-full border-t border-slate-800">
            <MudButton Variant="Variant.Text"
                       Color="Color.Default"
                       OnClick="Close"
                       Class="text-slate-400 hover:text-white">
                Close
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ConfirmationNumber"
                       OnClick="LogHike"
                       Class="px-6 py-2 font-bold shadow-md shadow-emerald-950/60">
                Permit & Log
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public HikingDestination Trail { get; set; } = new();

    private void Close() => MudDialog.Close();

    private void LogHike()
    {
        MudDialog.Close();
        Navigation.NavigateTo("/permits");
    }

    private string GetDifficultyBadgeClass(string difficulty) => difficulty switch
    {
        "Easy" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/40",
        "Moderate" => "bg-amber-950/60 text-amber-300 border border-amber-800/40",
        "Expert" => "bg-rose-950/60 text-rose-300 border border-rose-800/40",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Open" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/50",
        "Weather Advisory" => "bg-amber-950/60 text-amber-300 border border-amber-800/50",
        "Closed" => "bg-rose-950/60 text-rose-300 border border-rose-800/50",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusDot(string status) => status switch
    {
        "Open" => "bg-emerald-400",
        "Weather Advisory" => "bg-amber-400",
        "Closed" => "bg-rose-400",
        _ => "bg-slate-400"
    };
}

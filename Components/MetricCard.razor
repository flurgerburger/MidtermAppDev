<div class="bg-slate-900/90 rounded-2xl p-6 sm:p-7 border border-slate-800/90 shadow-sm hover:shadow-md hover:border-emerald-800/60 transition-all duration-300 flex flex-col justify-between relative overflow-hidden group @CustomClass">
    <!-- Top row: Metric label and Icon -->
    <div class="flex items-start justify-between gap-4 mb-4">
        <div class="flex-1 pr-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block leading-tight">
                @Title
            </span>
            <div class="mt-2.5">
                <h3 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
                    @Value
                </h3>
            </div>
        </div>
        
        <div class="w-12 h-12 rounded-xl flex-shrink-0 flex items-center justify-center transition-transform group-hover:scale-105 duration-200 border @GetIconBackgroundClass()">
            <MudIcon Icon="@Icon" Color="@IconColor" Size="Size.Medium" />
        </div>
    </div>

    <!-- Bottom: Subtitle and optional trend/badge -->
    <div class="flex items-center justify-between text-xs pt-3 mt-1 border-t border-slate-800/80">
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <span class="text-slate-400 truncate mr-2">
                @Subtitle
            </span>
        }
        else
        {
            <span></span>
        }

        @if (!string.IsNullOrEmpty(Trend))
        {
            <div class="inline-flex items-center gap-1 font-medium px-2.5 py-1 rounded-full text-[11px] @GetTrendClass()">
                <MudIcon Icon="@GetTrendIcon()" Size="Size.Small" Class="!w-3 !h-3" />
                <span>@Trend</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(Badge))
        {
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium bg-slate-800/80 text-slate-300 border border-slate-700/60">
                @Badge
            </span>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Metric";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Analytics;
    [Parameter] public Color IconColor { get; set; } = Color.Primary;
    [Parameter] public string? Trend { get; set; }
    [Parameter] public bool? IsPositiveTrend { get; set; }
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string? CustomClass { get; set; }

    private string GetIconBackgroundClass() => IconColor switch
    {
        Color.Primary or Color.Success => "bg-emerald-950/60 text-emerald-400 border-emerald-800/50 shadow-inner",
        Color.Warning => "bg-amber-950/50 text-amber-300 border-amber-800/40 shadow-inner",
        Color.Info => "bg-teal-950/50 text-teal-300 border-teal-800/40 shadow-inner",
        Color.Error => "bg-rose-950/50 text-rose-300 border-rose-800/40 shadow-inner",
        _ => "bg-slate-800/60 text-slate-300 border-slate-700/50"
    };

    private string GetTrendClass()
    {
        if (IsPositiveTrend == true)
            return "bg-emerald-950/60 text-emerald-300 border border-emerald-800/40";
        if (IsPositiveTrend == false)
            return "bg-rose-950/60 text-rose-300 border border-rose-800/40";
        return "bg-slate-800 text-slate-300 border border-slate-700/60";
    }

    private string GetTrendIcon()
    {
        if (IsPositiveTrend == true)
            return Icons.Material.Filled.TrendingUp;
        if (IsPositiveTrend == false)
            return Icons.Material.Filled.TrendingDown;
        return Icons.Material.Filled.TrendingFlat;
    }
}

@page "/explore"
@implements IDisposable
@inject HikingStateService HikingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="explore-layout">
    <!-- Header -->
    <div class="explore-page-header">
        <div class="explore-page-heading">
            <div class="explore-page-eyebrow">
                <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs font-semibold bg-emerald-950/60 text-emerald-300 border border-emerald-800/50">
                    Cebu Trail Suggester
                </span>
                <span class="text-xs text-slate-400">@FilteredTrails.Count() destinations matching criteria</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                Find Your Cebu Hiking Adventure
            </h1>
            <p class="explore-page-description text-sm text-slate-400 leading-relaxed">
                Explore beginner nature walks, intermediate ridge lines, and challenging endurance routes across Cebu Island. Click any trail to inspect full notes and safety advisories.
            </p>
        </div>

        <div class="explore-page-actions flex items-center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Casino"
                       OnClick="TriggerSuggester"
                       Class="px-5 py-2.5 font-bold shadow-md shadow-emerald-950/50">
                Surprise Peak
            </MudButton>

            <!-- Grid / Table View Toggle -->
            <div class="explore-view-toggle flex items-center bg-slate-900 rounded-xl border border-slate-800">
                <button type="button"
                        class="p-2 rounded-lg text-xs font-medium transition-colors @(_isGridView ? "bg-emerald-900/60 text-emerald-300 border border-emerald-700/50" : "text-slate-400 hover:text-white")"
                        @onclick="() => _isGridView = true"
                        title="Grid View">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                </button>
                <button type="button"
                        class="p-2 rounded-lg text-xs font-medium transition-colors @(!_isGridView ? "bg-emerald-900/60 text-emerald-300 border border-emerald-700/50" : "text-slate-400 hover:text-white")"
                        @onclick="() => _isGridView = false"
                        title="Table View">
                    <MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" />
                </button>
            </div>
        </div>
    </div>

    <!-- Filter Controls with Generous Spacing -->
    <div class="explore-filter-card bg-slate-900/90 rounded-3xl border border-slate-800/90 shadow-sm">
        <!-- Quick Tier Filter Chips -->
        <div class="explore-tier-filters flex flex-wrap items-center">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mr-1">Tiers:</span>
            <button type="button"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(string.IsNullOrEmpty(_selectedDifficulty) ? "bg-emerald-700 text-white shadow-md shadow-emerald-950/60" : "bg-slate-950 text-slate-300 border border-slate-800 hover:border-slate-700")"
                    @onclick='() => SetDifficultyFilter(string.Empty)'>
                All Tiers (@HikingService.TotalTrails)
            </button>
            <button type="button"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(_selectedDifficulty == "Easy" ? "bg-emerald-800 text-emerald-200 border border-emerald-600 shadow-md" : "bg-slate-950 text-slate-300 border border-slate-800 hover:border-slate-700")"
                    @onclick='() => SetDifficultyFilter("Easy")'>
                Easy & Beginner (7)
            </button>
            <button type="button"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(_selectedDifficulty == "Moderate" ? "bg-amber-800 text-amber-200 border border-amber-600 shadow-md" : "bg-slate-950 text-slate-300 border border-slate-800 hover:border-slate-700")"
                    @onclick='() => SetDifficultyFilter("Moderate")'>
                Moderate & Intermediate (7)
            </button>
            <button type="button"
                    class="px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(_selectedDifficulty == "Expert" ? "bg-rose-900 text-rose-200 border border-rose-700 shadow-md" : "bg-slate-950 text-slate-300 border border-slate-800 hover:border-slate-700")"
                    @onclick='() => SetDifficultyFilter("Expert")'>
                Hard & Endurance (6)
            </button>
        </div>

        <div class="explore-search-filters">
            <!-- Search Query -->
            <MudTextField @bind-Value="_searchQuery"
                          Placeholder="Search trail name, peak, route..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Normal"
                          Clearable="true"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="bg-slate-950/70" />

            <!-- Municipality Dropdown Filter -->
            <MudSelect @bind-Value="_selectedMunicipality"
                       Label="Cebu Municipality"
                       Variant="Variant.Outlined"
                       Margin="Margin.Normal"
                       Dense="true"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.LocationCity"
                       Class="bg-slate-950/70">
                <MudSelectItem Value="@string.Empty">All Cebu Municipalities</MudSelectItem>
                @foreach (var mun in HikingDestination.Municipalities)
                {
                    <MudSelectItem Value="@mun">@mun</MudSelectItem>
                }
            </MudSelect>

            <!-- Trail Status Filter -->
            <MudSelect @bind-Value="_selectedStatus"
                       Label="Access Status"
                       Variant="Variant.Outlined"
                       Margin="Margin.Normal"
                       Dense="true"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Info"
                       Class="bg-slate-950/70">
                <MudSelectItem Value="@string.Empty">All Statuses</MudSelectItem>
                @foreach (var st in HikingDestination.Statuses)
                {
                    <MudSelectItem Value="@st">@st</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (HasActiveFilters)
        {
            <div class="explore-active-filters flex flex-wrap items-center justify-between border-t border-slate-800 text-xs">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-slate-400 font-medium">Active filters:</span>
                    @if (!string.IsNullOrEmpty(_selectedMunicipality))
                    {
                        <span class="px-2.5 py-1 rounded-md bg-emerald-950/60 text-emerald-300 border border-emerald-800/40 font-medium">
                            Municipality: @_selectedMunicipality
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(_selectedDifficulty))
                    {
                        <span class="px-2.5 py-1 rounded-md bg-amber-950/60 text-amber-300 border border-amber-800/40 font-medium">
                            Tier: @_selectedDifficulty
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(_selectedStatus))
                    {
                        <span class="px-2.5 py-1 rounded-md bg-teal-950/60 text-teal-300 border border-teal-800/40 font-medium">
                            Status: @_selectedStatus
                        </span>
                    }
                </div>

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           OnClick="ClearFilters">
                    Clear Filters
                </MudButton>
            </div>
        }
    </div>

    <!-- Active Presentation: Grid View (Clean Cards with Pop-up trigger) or Table View -->
    @if (_isGridView)
    {
        @if (FilteredTrails.Any())
        {
            <!-- Responsive trail card grid -->
            <div class="explore-trail-grid">
                @foreach (var trail in FilteredTrails)
                {
                    <!-- Cleaned-up card with generous inner padding & consistent vertical spacing -->
                    <div class="explore-card trail-explore-card bg-slate-900/90 rounded-3xl border border-slate-800/90 shadow-sm hover:border-emerald-600/70 hover:bg-slate-900 hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between cursor-pointer group"
                         @onclick="@(() => OpenTrailDetails(trail))">
                        <div class="trail-explore-card__header">
                            <!-- Header tags: Difficulty, Status, Rating -->
                            <div class="trail-explore-card__badges flex items-center justify-between">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @GetDifficultyBadgeClass(trail.Difficulty)">
                                    @trail.Difficulty
                                </span>

                                <div class="trail-explore-card__status-rating flex items-center">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold @GetStatusBadgeClass(trail.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full mr-1.5 @GetStatusDot(trail.Status)"></span>
                                        @trail.Status
                                    </span>
                                    <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-400 bg-slate-950/80 border border-slate-800/80 px-2 py-0.5 rounded-lg">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="!w-3.5 !h-3.5 text-amber-400" />
                                        @trail.Rating.ToString("F1")
                                    </span>
                                </div>
                            </div>

                            <!-- Trail Title & Location with clean vertical spacing -->
                            <div class="trail-explore-card__title-location">
                                <h3 class="text-xl font-extrabold text-white group-hover:text-emerald-400 transition-colors leading-snug">
                                    @trail.TrailName
                                </h3>

                                <div class="trail-explore-card__location flex items-center text-xs text-emerald-400 font-medium">
                                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Class="!w-4 !h-4 text-emerald-500 shrink-0" />
                                    <span>@trail.LocalMunicipality, Cebu</span>
                                </div>
                            </div>
                        </div>

                        <!-- Clean Metrics & Action Controls with consistent vertical spacing -->
                        <div class="trail-explore-card__footer">
                            <!-- Metrics Summary Block -->
                            <div class="trail-explore-card__metrics grid rounded-2xl bg-slate-950/70 border border-slate-800/80 text-center">
                                <div class="space-y-1">
                                    <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">Elevation</span>
                                    <span class="font-mono font-extrabold text-xs sm:text-sm text-slate-100 block">@trail.ElevationMeters m</span>
                                </div>
                                <div class="trail-explore-card__metric-item space-y-1">
                                    <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">Distance</span>
                                    <span class="font-mono font-extrabold text-xs sm:text-sm text-slate-100 block">@trail.DistanceKm.ToString("F1") km</span>
                                </div>
                                <div class="space-y-1">
                                    <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider">Permit</span>
                                    <span class="font-mono font-extrabold text-xs sm:text-sm text-emerald-400 block">
                                        @(trail.PermitFee == 0 ? "Free" : $"₱{trail.PermitFee:N0}")
                                    </span>
                                </div>
                            </div>

                            <!-- Dedicated Action Row -->
                            <div class="trail-explore-card__actions flex items-center">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Default"
                                           FullWidth="true"
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.Visibility"
                                           OnClick="@(() => OpenTrailDetails(trail))"
                                           Class="bg-slate-800 hover:bg-emerald-950/80 hover:text-emerald-300 text-slate-200 font-semibold py-2.5 rounded-xl text-xs transition-colors shadow-sm">
                                    View Details
                                </MudButton>

                                <MudIconButton Icon="@Icons.Material.Filled.ConfirmationNumber"
                                               Color="Color.Primary"
                                               Size="Size.Medium"
                                               OnClick="@(() => Navigation.NavigateTo("/permits"))"
                                               Class="bg-slate-800 hover:bg-slate-700 text-emerald-400 rounded-xl p-2.5 transition-colors shrink-0"
                                               title="Register Permit" />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="explore-empty-card bg-slate-900/80 rounded-3xl text-center border border-slate-800">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" Class="mb-3 text-slate-500" />
                <h3 class="font-bold text-slate-200 text-base">No Cebu trails match current filters</h3>
                <p class="text-xs text-slate-400 mt-1 mb-5">
                    Try broadening your municipality or difficulty selections to view more peaks.
                </p>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearFilters">Reset Filters</MudButton>
            </div>
        }
    }
    else
    {
        <!-- Table View -->
        <div class="explore-table-card bg-slate-900/90 rounded-3xl shadow-sm border border-slate-800/90">
            <MudTable Items="@FilteredTrails" Dense="false" Hover="true" Striped="false" Elevation="0" Class="w-full">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.TrailName)">Trail / Peak</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.LocalMunicipality)">Municipality</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.Difficulty)">Difficulty</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.ElevationMeters)">Elevation</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<HikingDestination, object>(x => x.PermitFee)">Fee</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Trail">
                        <div class="py-1">
                            <div class="font-bold text-white">@context.TrailName</div>
                            <div class="text-xs text-slate-400 font-mono">@context.DistanceKm km • ~@context.EstimatedMinutes mins</div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Municipality">
                        <span class="text-xs text-slate-300 font-medium">@context.LocalMunicipality</span>
                    </MudTd>
                    <MudTd DataLabel="Difficulty">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @GetDifficultyBadgeClass(context.Difficulty)">
                            @context.Difficulty
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Elevation">
                        <span class="font-mono text-xs font-semibold text-slate-200">@context.ElevationMeters m</span>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold @GetStatusBadgeClass(context.Status)">
                            <span class="w-1.5 h-1.5 rounded-full mr-1.5 @GetStatusDot(context.Status)"></span>
                            @context.Status
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Fee">
                        <span class="font-mono text-xs font-bold @(context.PermitFee == 0 ? "text-emerald-400" : "text-slate-200")">
                            @(context.PermitFee == 0 ? "Free" : $"₱{context.PermitFee:N0}")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenTrailDetails(context))">
                            Inspect
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20 }" />
                </PagerContent>
            </MudTable>
        </div>
    }
</div>

@code {
    private string _searchQuery = string.Empty;
    private string _selectedMunicipality = string.Empty;
    private string _selectedDifficulty = string.Empty;
    private string _selectedStatus = string.Empty;
    private bool _isGridView = true;

    protected override void OnInitialized()
    {
        HikingService.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_searchQuery) ||
        !string.IsNullOrEmpty(_selectedMunicipality) ||
        !string.IsNullOrEmpty(_selectedDifficulty) ||
        !string.IsNullOrEmpty(_selectedStatus);

    private IEnumerable<HikingDestination> FilteredTrails =>
        HikingService.Filter(_searchQuery, _selectedMunicipality, _selectedDifficulty, _selectedStatus);

    private void SetDifficultyFilter(string tier)
    {
        _selectedDifficulty = tier;
    }

    private void ClearFilters()
    {
        _searchQuery = string.Empty;
        _selectedMunicipality = string.Empty;
        _selectedDifficulty = string.Empty;
        _selectedStatus = string.Empty;
    }

    private async Task OpenTrailDetails(HikingDestination trail)
    {
        var parameters = new DialogParameters<TrailDetailDialog> { { x => x.Trail, trail } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<TrailDetailDialog>(trail.TrailName, parameters, options);
    }

    private async Task TriggerSuggester()
    {
        var suggestion = HikingService.GetRandomSuggestion(
            string.IsNullOrEmpty(_selectedMunicipality) ? null : _selectedMunicipality,
            string.IsNullOrEmpty(_selectedDifficulty) ? null : _selectedDifficulty);

        if (suggestion != null)
        {
            await OpenTrailDetails(suggestion);
        }
        else
        {
            Snackbar.Add("No open trails found matching your current filters. Try resetting.", Severity.Info);
        }
    }

    private string GetDifficultyBadgeClass(string difficulty) => difficulty switch
    {
        "Easy" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/40",
        "Moderate" => "bg-amber-950/60 text-amber-300 border border-amber-800/40",
        "Expert" => "bg-rose-950/60 text-rose-300 border border-rose-800/40",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Open" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/50",
        "Weather Advisory" => "bg-amber-950/60 text-amber-300 border border-amber-800/50",
        "Closed" => "bg-rose-950/60 text-rose-300 border border-rose-800/50",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusDot(string status) => status switch
    {
        "Open" => "bg-emerald-400",
        "Weather Advisory" => "bg-amber-400",
        "Closed" => "bg-rose-400",
        _ => "bg-slate-400"
    };

    public void Dispose()
    {
        HikingService.OnChange -= OnStateChanged;
    }
}

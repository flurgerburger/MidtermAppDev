@page "/"
@page "/dashboard"
@implements IDisposable
@inject HikingStateService HikingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<div class="dashboard-layout">
    <!-- Hero / Header Section -->
    <div class="dashboard-card dashboard-hero relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-950 via-slate-900 to-slate-950 text-white shadow-xl border border-emerald-900/40">
        <div class="dashboard-hero-content relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-900/40 text-emerald-300 border border-emerald-700/40 backdrop-blur-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Cebu Mountain Ridge Telemetry Active
            </div>
            <h1 class="dashboard-title text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-tight text-white">
                Cebu Hiking & Peak Explorer
            </h1>
            <p class="dashboard-description text-sm sm:text-base text-slate-300 leading-relaxed">
                Real-time safety conditions, elevation profiles, weather advisories, and permit logs for the rugged trails and karst peaks of Cebu Island.
            </p>

            <div class="dashboard-hero-actions flex flex-wrap items-center">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Explore"
                           OnClick="@(() => Navigation.NavigateTo("/explore"))"
                           Class="px-6 py-2.5 font-bold shadow-lg shadow-emerald-950/60">
                    Explore All 20 Cebu Trails
                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.Casino"
                           OnClick="SurpriseMeSuggestion"
                           Class="border-slate-700 hover:border-emerald-500 font-semibold px-5">
                    Surprise Peak Suggester
                </MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.ConfirmationNumber"
                           OnClick="@(() => Navigation.NavigateTo("/permits"))"
                           Class="text-slate-300 hover:text-white px-4 py-2 font-medium">
                    Permit Registry
                </MudButton>
            </div>
        </div>

        <!-- Decorative background icon -->
        <div class="absolute -right-8 -bottom-10 opacity-5 pointer-events-none text-emerald-400">
            <MudIcon Icon="@Icons.Material.Filled.Landscape" Style="font-size: 320px;" />
        </div>
    </div>

    <!-- Summary Metrics Cards Grid -->
    <div class="dashboard-metric-grid">
        <MetricCard Title="Total Cebu Trails"
                    Value="@HikingService.TotalTrails.ToString()"
                    Subtitle="Across 3 difficulty tiers"
                    Icon="@Icons.Material.Filled.Terrain"
                    IconColor="Color.Primary"
                    Trend="Island-Wide Network"
                    IsPositiveTrend="true"
                    CustomClass="dashboard-card dashboard-metric-card" />

        <MetricCard Title="Open Peaks"
                    Value="@HikingService.OpenTrails.ToString()"
                    Subtitle="@($"{GetPercentage(HikingService.OpenTrails):N0}% currently clear to hike")"
                    Icon="@Icons.Material.Filled.CheckCircle"
                    IconColor="Color.Success"
                    Trend="Good Conditions"
                    IsPositiveTrend="true"
                    CustomClass="dashboard-card dashboard-metric-card" />

        <MetricCard Title="Average Elevation"
                    Value="@($"{HikingService.AverageElevation:N0} m")"
                    Subtitle="Highest: Osmeña Peak (1,013 m)"
                    Icon="@Icons.Material.Filled.Landscape"
                    IconColor="Color.Info"
                    Badge="Dalaguete to Balamban"
                    CustomClass="dashboard-card dashboard-metric-card" />

        <MetricCard Title="Weather Alerts"
                    Value="@HikingService.AdvisoryTrails.ToString()"
                    Subtitle="@($"{HikingService.ClosedTrails} closed routes")"
                    Icon="@Icons.Material.Filled.WarningAmber"
                    IconColor="Color.Warning"
                    Badge="@(HikingService.AdvisoryTrails > 0 ? "Ridge Caution" : "Clear Skies")"
                    CustomClass="dashboard-card dashboard-metric-card" />
    </div>

    <!-- Top-Rated Cebu Trails & Municipal Distribution -->
    <div class="dashboard-content-grid">
        <!-- Top-Rated Trails (Cleaned up face with click-to-open detail popup) -->
        <div class="dashboard-card dashboard-highlighted-panel bg-slate-900/90 rounded-3xl border border-slate-800/90 shadow-sm flex flex-col justify-between">
            <div>
                <div class="dashboard-section-header flex items-center justify-between border-b border-slate-800/80">
                    <div class="dashboard-section-heading-copy">
                        <h2 class="text-xl font-extrabold text-white">Highlighted Cebu Destinations</h2>
                        <p class="text-xs text-slate-400">Click any card to open full trail notes and safety guidelines</p>
                    </div>

                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               OnClick="@(() => Navigation.NavigateTo("/explore"))">
                        View All
                    </MudButton>
                </div>

                <div class="dashboard-trail-grid">
                    @foreach (var trail in HikingService.GetAll().OrderByDescending(t => t.Rating).Take(4))
                    {
                        <!-- Cleaned-up, clickable card with generous padding & vertical spacing -->
                        <div class="dashboard-card trail-preview-card rounded-3xl border border-slate-800 bg-slate-950/70 hover:border-emerald-600/70 hover:bg-slate-900/90 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between cursor-pointer group shadow-sm"
                             @onclick="@(() => OpenTrailDetails(trail))">
                            <div class="trail-preview-card__details">
                                <!-- Top Badges: Difficulty & Status & Rating -->
                                <div class="trail-preview-card__badges flex items-center justify-between">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold @GetDifficultyBadgeClass(trail.Difficulty)">
                                        @trail.Difficulty
                                    </span>

                                    <div class="trail-preview-card__status-rating flex items-center">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold @GetStatusBadgeClass(trail.Status)">
                                            <span class="w-1.5 h-1.5 rounded-full mr-1.5 @GetStatusDot(trail.Status)"></span>
                                            @trail.Status
                                        </span>
                                        <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-400 bg-slate-900/90 border border-slate-800 px-2 py-0.5 rounded-lg">
                                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Class="!w-3.5 !h-3.5 text-amber-400" />
                                            @trail.Rating.ToString("F1")
                                        </span>
                                    </div>
                                </div>

                                <!-- Trail Title & Location with clean vertical spacing -->
                                <div class="trail-preview-card__title-location">
                                    <h3 class="font-extrabold text-lg sm:text-xl text-white group-hover:text-emerald-400 transition-colors leading-snug">
                                        @trail.TrailName
                                    </h3>

                                    <div class="trail-preview-card__location flex items-center text-xs text-emerald-400 font-medium">
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="!w-4 !h-4 text-emerald-500 shrink-0" />
                                        <span>@trail.LocalMunicipality, Cebu</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Clean Metrics Footer with generous separation -->
                            <div class="trail-preview-card__metrics border-t border-slate-800/80 flex items-center justify-between text-xs">
                                <div class="trail-preview-card__metric-values flex items-center text-slate-300 font-mono">
                                    <span title="Elevation" class="inline-flex items-center gap-1 text-slate-300">
                                        <span class="text-emerald-500">▲</span> @trail.ElevationMeters m
                                    </span>
                                    <span class="text-slate-600">•</span>
                                    <span title="Distance" class="text-slate-300">@trail.DistanceKm.ToString("F1") km</span>
                                </div>

                                <div class="trail-preview-card__permit flex items-center">
                                    <span class="font-semibold text-emerald-400 font-mono bg-emerald-950/60 border border-emerald-800/40 px-2.5 py-1 rounded-lg">
                                        @(trail.PermitFee == 0 ? "Free" : $"₱{trail.PermitFee:N0}")
                                    </span>
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="text-slate-500 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all !w-4 !h-4" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Municipal Trail Counts (1 Column) -->
        <div class="dashboard-card dashboard-municipality-panel bg-slate-900/90 rounded-3xl border border-slate-800/90 shadow-sm flex flex-col justify-between">
            <div>
                <div class="dashboard-section-header flex items-center justify-between border-b border-slate-800/80">
                    <div class="dashboard-section-heading-copy">
                        <h2 class="text-xl font-extrabold text-white">Cebu Municipalities</h2>
                        <p class="text-xs text-slate-400">Trail distribution by territory</p>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Map" Color="Color.Primary" Size="Size.Medium" />
                </div>

                <div class="dashboard-municipality-list">
                    @foreach (var mun in HikingService.Municipalities.Take(6))
                    {
                        var trails = HikingService.GetAll().Where(t => t.LocalMunicipality == mun).ToList();
                        var count = trails.Count;
                        var pct = HikingService.TotalTrails > 0 ? (count / (double)HikingService.TotalTrails) * 100 : 0;

                        <div class="dashboard-municipality-item">
                            <div class="dashboard-municipality-item-heading flex items-center justify-between text-xs">
                                <span class="font-semibold text-slate-200">@mun</span>
                                <span class="font-mono text-slate-400">@count trail@(count > 1 ? "s" : "") (@pct:N0%)</span>
                            </div>
                            <MudProgressLinear Color="Color.Primary" Value="@pct" Rounded="true" Size="Size.Small" Class="h-2" />
                        </div>
                    }
                </div>
            </div>

            <div class="dashboard-municipality-action border-t border-slate-800/80">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Tune"
                           OnClick="@(() => Navigation.NavigateTo("/explore"))"
                           Class="border-slate-700 text-slate-300 hover:text-white hover:border-emerald-500 py-2.5 rounded-xl font-medium">
                    Filter by Cebu Municipality
                </MudButton>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        HikingService.OnChange += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private double GetPercentage(int count) =>
        HikingService.TotalTrails == 0 ? 0 : (count / (double)HikingService.TotalTrails) * 100;

    private async Task OpenTrailDetails(HikingDestination trail)
    {
        var parameters = new DialogParameters<TrailDetailDialog> { { x => x.Trail, trail } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<TrailDetailDialog>(trail.TrailName, parameters, options);
    }

    private async Task SurpriseMeSuggestion()
    {
        var suggestion = HikingService.GetRandomSuggestion();
        if (suggestion != null)
        {
            await OpenTrailDetails(suggestion);
        }
        else
        {
            Snackbar.Add("No open trails currently match criteria.", Severity.Info);
        }
    }

    private string GetDifficultyBadgeClass(string difficulty) => difficulty switch
    {
        "Easy" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/40",
        "Moderate" => "bg-amber-950/60 text-amber-300 border border-amber-800/40",
        "Expert" => "bg-rose-950/60 text-rose-300 border border-rose-800/40",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusBadgeClass(string status) => status switch
    {
        "Open" => "bg-emerald-950/60 text-emerald-300 border border-emerald-800/50",
        "Weather Advisory" => "bg-amber-950/60 text-amber-300 border border-amber-800/50",
        "Closed" => "bg-rose-950/60 text-rose-300 border border-rose-800/50",
        _ => "bg-slate-800 text-slate-300 border border-slate-700"
    };

    private string GetStatusDot(string status) => status switch
    {
        "Open" => "bg-emerald-400",
        "Weather Advisory" => "bg-amber-400",
        "Closed" => "bg-rose-400",
        _ => "bg-slate-400"
    };

    public void Dispose()
    {
        HikingService.OnChange -= OnStateChanged;
    }
}

@page "/management"
@implements IDisposable
@inject ItemStateService StateService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<div class="space-y-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300">
                    Data Grid & CRUD Operations
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400">@StateService.TotalCount total records</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
                Item Management
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Filter, inspect, create, modify, and delete domain-neutral entities with real-time reactive sync.
            </p>
        </div>

        <div class="flex items-center gap-3">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       OnClick="ConfirmReset">
                Reset Sample Data
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                Create Record
            </MudButton>
        </div>
    </div>

    <!-- Quick Stat Chips -->
    <div class="flex flex-wrap items-center gap-3 text-xs">
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium">
            <span class="text-slate-500 dark:text-slate-400">Active:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400 ml-1">@StateService.ActiveCount</span>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium">
            <span class="text-slate-500 dark:text-slate-400">Pending / In Progress:</span>
            <span class="font-bold text-amber-600 dark:text-amber-400 ml-1">@StateService.PendingCount</span>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium">
            <span class="text-slate-500 dark:text-slate-400">Completed:</span>
            <span class="font-bold text-indigo-600 dark:text-indigo-400 ml-1">@StateService.CompletedCount</span>
        </div>
        <div class="px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 font-medium">
            <span class="text-slate-500 dark:text-slate-400">Total Value:</span>
            <span class="font-bold font-mono text-slate-800 dark:text-slate-200 ml-1">${@StateService.TotalValue.ToString("N2")}</span>
        </div>
    </div>

    <!-- Main Data Table Component -->
    <ItemTable Items="@StateService.GetAll()"
               ShowActions="true"
               Dense="false"
               Hover="true"
               OnEdit="HandleEdit"
               OnDelete="HandleDelete" />
</div>

@code {
    protected override void OnInitialized()
    {
        StateService.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ItemDialog>("Create New Record", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is GenericItem newItem)
        {
            StateService.Add(newItem);
            Snackbar.Add($"Record '{newItem.Title}' added successfully!", Severity.Success);
        }
    }

    private async Task HandleEdit(GenericItem item)
    {
        var parameters = new DialogParameters<ItemDialog>
        {
            { x => x.Item, item },
            { x => x.IsEdit, true }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ItemDialog>("Edit Record", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is GenericItem updatedItem)
        {
            StateService.Update(updatedItem);
            Snackbar.Add($"Record '{updatedItem.Title}' saved successfully!", Severity.Success);
        }
    }

    private async Task HandleDelete(GenericItem item)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Confirmation",
            $"Are you sure you want to permanently delete record '{item.Title}'?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            StateService.Delete(item.Id);
            Snackbar.Add($"Record '{item.Title}' deleted.", Severity.Info);
        }
    }

    private async Task ConfirmReset()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Reset In-Memory Data",
            "This will restore the initial set of dummy records and discard any runtime changes. Proceed?",
            yesText: "Reset",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            StateService.ResetToDefaults();
            Snackbar.Add("State has been reset to default dummy data.", Severity.Warning);
        }
    }

    public void Dispose()
    {
        StateService.OnChange -= OnStateChanged;
    }
}

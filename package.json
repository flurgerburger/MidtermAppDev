{
  "name": "midterm-blazor-boilerplate",
  "version": "1.0.0",
  "description": "Generic .NET 10 Blazor Web App with MudBlazor 9.11.0 and Tailwind CSS 4",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i Styles/tailwind.css -o wwwroot/css/tailwind.css --minify",
    "watch:css": "npx @tailwindcss/cli -i Styles/tailwind.css -o wwwroot/css/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0"
  }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <!-- Automatic Tailwind CSS 4 build hook during dotnet build -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="Exists('node_modules')">
    <Exec Command="npx @tailwindcss/cli -i Styles/tailwind.css -o wwwroot/css/tailwind.css --minify" ContinueOnError="true" />
  </Target>

</Project>
